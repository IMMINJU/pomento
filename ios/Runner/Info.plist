<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Pomento</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>pomento</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- 파일 앱의 "내 iPhone"에 Pomento 폴더가 보이게 한다. 음원을 여기로
	     직접 옮겨 넣는 것이 이 앱의 유일한 반입 경로다. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- 백그라운드 재생 -->
	<!-- 이 키가 없으면 업로드한 빌드마다 App Store Connect에서 수출 규정
	     질문에 손으로 답해야 하고, 답하기 전까지 테스터가 설치할 수 없다.
	     쓰는 암호화는 Spotify Web API를 부르는 HTTPS뿐이라 면제 대상이다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- 다른 앱에서 "공유 > Pomento"로 음원을 보낼 수 있게 한다. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Audio</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.audio</string>
				<string>public.mp3</string>
				<string>public.aifc-audio</string>
				<string>org.xiph.flac</string>
				<string>org.xiph.ogg-audio</string>
			</array>
		</dict>
	</array>
	<!-- Spotify 인증이 돌아올 주소. 대시보드의 Redirect URI와 같아야 한다. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.pomento.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pomento</string>
			</array>
		</dict>
	</array>
	<!-- App Remote가 Spotify 앱이 깔려 있는지 물어보려면 이 목록에 있어야
	     한다. iOS는 등록하지 않은 스킴에 canOpenURL을 허용하지 않는다. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<!-- 음악 앱 보관함(MPMediaLibrary)을 읽는다. 이 키가 없으면 조회
	     시점에 시스템이 앱을 종료시킨다.

	     한동안 이 키를 일부러 비워두었다. 보관함 동기화가 자켓과 태그를
	     애플 카탈로그 것으로 바꾸는 문제를 접근 자체를 막아 피하려는
	     선택이었다. 지금은 보관함에 있는 음원을 읽되 태그와 자켓은 파일에
	     박힌 값을 먼저 보고, 못 읽을 때만 음악 앱 값으로 떨어진다.
	     AppDelegate.swift의 libraryMetadata를 볼 것.

	     이 API로 원본 파일에 쓰는 길은 없다. 읽기만 한다. -->
	<key>NSAppleMusicUsageDescription</key>
	<string>아이폰 음악 앱에 있는 음원을 Pomento 라이브러리에 넣기 위해 읽습니다. 곡을 바꾸거나 지우지 않습니다.</string>
</dict>
</plist>
